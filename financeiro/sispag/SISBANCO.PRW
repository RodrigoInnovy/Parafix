OBJETIVO: ESSE PROGRAMA TEM COMO OBJETIVO PREENCHER CORRETAMENTE OS DETALHES DO SEGUIMENTO A NO ARQUIVO DE REMESSA PARA DOC/TED DO SISPAG
NO MANUAL DO BANCO ITAU, INFORMA QUE SE A CONTA FOR DO ITAU OU UNIBANCO, ELE TEM UM MODELO ESPECIFICO PARA DETALHAR O SEGUIMENTO A NO ARQUIVO DE REMESSA,
SE FOR DIFERENTE DE ITAU OU UNIBANCO, ELE TEM QUE SER PREENCHIDO DE ACORDO COM O MANUAL, NA NOTA 11, CONTAS DE OUTROS BANCOS.
ESSE PROGRAMA SEPARA ESSAS INFORMAÇÕES NA EXECUÇÃO DA GERAÇÃO DO ARQUIVO.
*******************************************************************/

USER FUNCTION SISBANCO()

LOCAL cRetCNAB 	:= ""

IF !EMPTY(SA2->A2_BANCO)
		IF SA2->A2_BANCO == '341' .OR. SA2->A2_BANCO == '409'
				cRetCNAB := '0' + STRZERO(VAL(SA2->A2_AGENCIA),4)+' 000000'+STRZERO(VAL(SA2->A2_NUMCON),6)+' '+ ALLTRIM(SA2->A2_DVCTA)   
		
		ELSE	
			cRetCNAB := STRZERO(VAL(SA2->A2_AGENCIA),5)+ " " + STRZERO(VAL(SA2->A2_NUMCON),12)
	
				
		IF  !EMPTY(SA2->A2_DVCTA) 
				cRetCNAB += " " + ALLTRIM(SA2->A2_DVCTA)
		
		ELSE
				cRetCNAB += "  " 
		ENDIF
		ENDIF	
		ENDIF

RETURN cRetCNAB
