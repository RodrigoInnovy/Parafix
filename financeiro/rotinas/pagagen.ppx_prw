Function U_PagAgen()
   _Agencia := "00000 "
   if SEA->EA_Modelo == "31"
      _CodBar  := trim(SE2->E2_CODBAR)
      _cBanco  := left(_CodBar,3)
      _Ag      := ""
      if _cBanco == "001"
         _nCol    := iif(len(_CodBar)>44,5,20)
         _Agencia := u_Mod11Base7( substr(_CodBar,_nCol,4), 6)

      endif
   endif
Return(_Agencia)