// ³                ³03/12/99³  Data de Pagamento e Limite para desconto   ³
// ³                ³        ³alterada para digitacao manual. Ao chamar ro-³
// ³                ³        ³tina, chama primeiro tela para data de paga- ³
// ³                ³        ³mento.                                       ³
// ÃÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´
// ³Uso SigaFin - Empresa ROYALPLAS-CNAB                                   ³
// ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
//
// - IMPLANTADO NA ROYALPLAS EM 24/08/2000 POR VITOR LUIS FATTORI-SIGACPS

_cDATA := "00000000"

IF !EMPTY(SE2->E2_CODBAR)
   IF (VAL( SUBSTR(SE2->E2_CODBAR,10,10)) )   > 0

      IF ((VAL( SUBSTR(SE2->E2_CODBAR,10,10))/100)  - SE2->E2_SALDO) >0

         _cDATA := Str( Year(SE2->E2_VENCREA),4)+StrZero( Month(SE2->E2_VENCREA),2 )+ ;
         StrZero( Day(SE2->E2_VENCREA) ,2)      

      ENDIF
   endif
ENDIF


