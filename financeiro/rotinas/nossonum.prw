User Function NossoNum(_fSize)
   _cTipo := alltrim(SE1->E1_NumBco)
   if empty(_cTipo)
      _cTipo := SEE->EE_FaxAtu
      _cTipo := SomaStr(_cTipo,"1")
      _cTipo := strzero(val(_cTipo),12)
      if _cTipo < SEE->EE_FaxFim
         reclock("SEE",.f.)
         SEE->EE_FaxAtu := _cTipo
         msUnLock()
         reclock("SE1",.f.)
         SE1->E1_NumBco := "000" + _cTipo
         msUnLock()
      endif
   endif
Return (right(_cTipo,_fSize))