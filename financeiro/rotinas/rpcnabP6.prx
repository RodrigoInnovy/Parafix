_cT := "1"


// 16/11/99 - conta sempre tera tipo 1=conta corrente

//IF EMPTY(SE2->E2_CODBAR) .AND. SE2->E2_BANCO=="237"
IF EMPTY(SE2->E2_CODBAR) .AND. SA2->A2_BANCO=="237"
        IF LEN(ALLTRIM(SA2->A2_NUMCON)) > 8
                 _cT := "2"
        ENDIF
ENDIF

IF (!EMPTY(SE2->E2_CODBAR) .AND. SUBSTR(SE2->E2_CODBAR,1,3)=="237")
        _nX := VAL(SUBSTR(SE2->E2_CODBAR,37,7))
        _cX := ALLTRIM(STR(INT(_nX)))

        IF LEN(_cX) > 6        //POUPANCA
                _cT := "2"
        ENDIF
ENDIF



// Substituido pelo assistente de conversao do AP6 IDE em 04/09/08 ==> __Return(_cT)
Return(_cT)        // incluido pelo assistente de conversao do AP6 IDE em 04/09/08
