User Function VL510_002()

SetPrvt("_CALIAS,_REC,_INDEX,_VVALOR,")

_cAlias := Alias()
_Rec    := Recno()
_INdex  := Indexord()


cNaturezas:= "21110201/21110202/21110203/21110204/21110205/21110206/21110207/21110208/"
cNaturezas+= "21110301/21110302/21110303/21110304/21110305/21110306/21110307/21110308/"
cNaturezas+= "21110407/21110411/21110506/21110507/21110509/21120401/21120402/21120403/"
cNaturezas+= "21120803/21120805/21121101/21121105/21121109/21121110/21121201/21121202/"
cNaturezas+= "21121203/21121204/21121303/21121304/21121305/21121306/21121307/21121308/"
cNaturezas+= "21121314/21121315/21121316/21130101/21130102/21130103/21130104/21130105/"
cNaturezas+= "21130106/21130204/21130205/21130206/21130207/21130208/21130209/"
cNaturezas+= "21210301/21210302/21210303/21210304/21220101/21220102/21220103/21220201/"
cNaturezas+= "21220202/21220203/21220204/21220205/21220206/21220207/21220208/21220209/21220210/"
cNaturezas+= "21220301/21220302/21220303/21220304/21220305/21220306/21220401/21220402/21220403/"
cNaturezas+= "21220404/21220405/21220406/21220407/"


IF(SE2->E2_MULTNAT <>"2") .AND. (SEV->EV_RATEICC<>"1") .AND.(!ALLTRIM(SEV->EV_NATUREZ)$cNaturezas) 
    _vvalor  :=SEV->EV_VALOR
	
		else
			_vvalor:= 0
			
endif


DbSelectArea(_cAlias)
DbSetOrder(_Index)
DbGoto(_rec)

Return(_vvalor)



