#Include "Protheus.ch"
#Include "Topconn.ch"
#Include "MsObject.ch"
#define del   ";"
#define linha chr(13)+chr(10)

User Function PCPREL01()

	//??????????????????????????????????????????????????????????????????????
	//? Declaracao de Variaveis                                             ?
	//???????????????????????????????????????????????????????????????????????

	Local cDesc1       := "Este programa tem como objetivo imprimir relatorio "
	Local cDesc2       := "de acordo com os parametros informados pelo usuario."
	Local cDesc3       := "Movimentacao Armazem"
	Local cPict        := ""
	Local titulo       := "Movimentacao Armazem (Entradas x Saidas)"
	Local nLin         := 80
	//                     1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
	Local Cabec2       := " "
	Local Cabec1       := "Armz.  Cod. Prod.         Desc. Prod.               Tipo Mov.     Qtde       Unid.    Qtde 2 Um          Unid 2          Ord. Producao          Pallet         Emissao          Usuario"
	Local imprime      := .T.
	Local aOrd := {}
	Local cPerg:="PCP001"
	Local oObj := FWSX1Util():New()
	Private lEnd         := .F.
	Private lAbortPrint  := .F.
	Private CbTxt        := ""
	Private limite       := 132
	Private tamanho      := "G"
	Private nomeprog     := "PCP001" // Coloque aqui o nome do programa para impressao no cabecalho
	Private nTipo        := 15
	Private aReturn      := { "Zebrado", 1, "Administracao", 2, 2, 1, "", 1}
	Private nLastKey     := 0
	Private cbtxt      := Space(10)
	Private cbcont     := 00
	Private CONTFL     := 01
	Private m_pag      := 01
	Private wnrel      := "SESTRE31" // Coloque aqui o nome do arquivo usado para impressao em disco
	Private cString := ""

	private _cFilePath
	private _nHandle

    oObj:AddGroup(cPerg)
	aPergunte := oObj:GetGroup(cPerg)

	// Grupo/Ordem/Pergunta/Variavel/Tipo/Tamanho/Decimal/Presel/GSC/Valid/Var01/Def01/Cnt01/Var02/Def02/Cnt02/Var03/Def03/Cnt03/Var04/Def04/Cnt04/Var05/Def05/Cnt05
	aAdd(aRegs, {cPerg, "01", "Produto de",					"Produto de", "Produto de",					"mv_ch1", "D", 08, 0, 0, "G", "", "MV_PAR01", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
	aAdd(aRegs, {cPerg, "02", "Produto Ate",				"Produto Ate", "Produto Ate",				"mv_ch2", "D", 08, 0, 0, "G", "", "MV_PAR02", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
	aAdd(aRegs, {cPerg, "03", "Armazem de",					"Armazem de", "Armazem de",						"mv_ch3", "C", 11, 0, 0, "G", "", "MV_PAR03", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "SC2"})
	aAdd(aRegs, {cPerg, "04", "Armazem Ate",			    "Armazem Ate","Armazem Ate",						"mv_ch4", "C", 11, 0, 0, "G", "", "MV_PAR04", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "SC2"})
	aAdd(aRegs, {cPerg, "05", "Data de",					"Data de",	   "Data de",					"mv_ch5", "C", 20, 0, 0, "G", "", "MV_PAR05", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "SB1"})
	aAdd(aRegs, {cPerg, "06", "Data Ate",				"Data Ate",				"Data Ate",				"mv_ch6", "C", 20, 0, 0, "G", "", "MV_PAR06", "",		"",		"",		"", "", "",		"",		"",		"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "SB1"})
	aAdd(aRegs, {cPerg, "07", "OP de",	"OP de",	"OP de",	"mv_ch7", "N", 01, 0, 1, "C", "", "MV_PAR07", "Sim",	"Sim",	"Sim",	"", "", "Nao",	"Nao",	"Nao",	"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
	aAdd(aRegs, {cPerg, "07", "OP Ate",	"OP Ate",	"OP Ate",	"mv_ch7", "N", 01, 0, 1, "C", "", "MV_PAR07", "Sim",	"Sim",	"Sim",	"", "", "Nao",	"Nao",	"Nao",	"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
	aAdd(aRegs, {cPerg, "07", "Tipo Mov. ",	"Tipo Mov. ",	"Tipo Mov. ",	"mv_ch7", "N", 01, 0, 1, "C", "", "MV_PAR07", "Sim",	"Sim",	"Sim",	"", "", "Nao",	"Nao",	"Nao",	"", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})

	FOR i := 1 to LEN(aRegs)
		IF !dbSeek(cPerg+aRegs[i,2])
			MsgAlert(" O item " + aRegs[i,2] + "  '" + aRegs[i,3] + "' " +  " do grupo de perguntas" + " " + cPerg + " " +  "não está cadastrado" + ", a partir de agora o grupo perguntas deverá ser criado pelo configurador")
		EndIf
	NEXT
	

	//??????????????????????????????????????????????????????????????????????
	//? Monta a interface padrao com o usuario...                           ?
	//???????????????????????????????????????????????????????????????????????

	wnrel := SetPrint(cString,NomeProg,cperg,@titulo,cDesc1,cDesc2,cDesc3,.F.,aOrd,.F.,Tamanho,,.F.)


	If nLastKey == 27
		Return
	Endif

	SetDefault(aReturn,cString)

	If nLastKey == 27
		Return
	Endif

	nTipo := If(aReturn[4]==1,15,18)

	//??????????????????????????????????????????????????????????????????????
	//? Processamento. RPTSTATUS monta janela com a regua de processamento. ?
	//???????????????????????????????????????????????????????????????????????

	RptStatus({|| RunReport(Cabec1,Cabec2,Titulo,nLin) },Titulo)

Return

/*/
?????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
????????????????????????????????????????????????????????????????????????????
???Fun??o    ?RUNREPORT ? Autor ? AP6 IDE            ? Data ?  10/04/06   ???
????????????????????????????????????????????????????????????????????????????
???Descri??o ? Funcao auxiliar chamada pela RPTSTATUS. A funcao RPTSTATUS ???
???          ? monta a janela com a regua de processamento.               ???
????????????????????????????????????????????????????????????????????????????
???Uso       ? Programa principal                                         ???
????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
/*/

Static Function RunReport(Cabec1,Cabec2,Titulo,nLin)

	cQuery := "SELECT D3_COD, B1_DESC, D3_LOCAL, D3_TM, D3_CF, D3_QUANT, D3_EMISSAO, D3_ZZOP, D3_OP, D3_ZZPALET, D3_UM, D3_SEGUM, D3_QTSEGUM, D3_USUARIO "
	cQuery += "FROM "+ retSqlName("SD3")+ " SD3 INNER JOIN " +retSqlName("SB1")+ " SB1 "
	cQuery += "ON  D3_FILIAL = B1_FILIAL "
	cQuery += "AND D3_COD    = B1_COD "
	cQuery += "AND SB1.D_E_L_E_T_ !='*' "
	cQuery += "WHERE D3_COD >= '"+MV_PAR01+"' AND D3_COD   <= '"+MV_PAR02+"'"
	cQuery += "AND D3_LOCAL >= '"+MV_PAR03+"' AND D3_LOCAL <= '"+MV_PAR04+"'"
	cQuery += "AND D3_EMISSAO  >= '"+dtos(MV_PAR05)+"' AND D3_EMISSAO  <= '"+dtos(MV_PAR06)+"'"
	cQuery += "AND (D3_ZZOP != '' OR D3_OP !='') "                     
	cQuery += "AND (D3_ZZOP  >= '"+MV_PAR07+"' AND D3_ZZOP  <= '"+MV_PAR08+"' OR D3_OP  >= '"+MV_PAR07+"' AND D3_OP  <= '"+MV_PAR08+"')"
	cQuery += "AND D3_ESTORNO = ''"
	if MV_PAR09 == 1
		cQuery += "AND D3_CF = 'RE0' "
	elseif MV_PAR09 == 2
		cQuery += "AND (D3_CF = 'DE4' OR D3_CF = 'DE0') "
	elseif MV_PAR09 == 3
		cQuery += "AND (D3_CF = 'DE4' OR D3_CF = 'RE0' OR D3_CF = 'PR0' OR D3_CF = 'DE0')"
	endif
	cQuery += "AND SD3.D_E_L_E_T_ !='*' "
	cQuery += "ORDER BY D3_LOCAL, D3_CF, D3_COD, D3_OP "

	TcQuery upper(cQuery) Alias S01 New

	dbSelectArea("S01")

	//??????????????????????????????????????????????????????????????????????
	//? SETREGUA -> Indica quantos registros serao processados para a regua ?
	//???????????????????????????????????????????????????????????????????????

	//SetRegua(_nLenS01)

	//??????????????????????????????????????????????????????????????????????
	//? Posicionamento do primeiro registro e loop principal. Pode-se criar ?
	//? a logica da seguinte maneira: Posiciona-se na filial corrente e pro ?
	//? cessa enquanto a filial do registro for a filial corrente. Por exem ?
	//? plo, substitua o dbGoTop() e o While !EOF() abaixo pela sintaxe:    ?
	//?                                                                     ?
	//? dbSeek(xFilial())                                                   ?
	//? While !EOF() .And. xFilial() == A1_FILIAL                           ?
	//???????????????????????????????????????????????????????????????????????

	While !S01->(EOF())

		If lAbortPrint
			@nLin,00 PSAY "*** CANCELADO PELO OPERADOR ***"
			Exit
		Endif

		If nLin > 55 // Salto de Pagina. Neste caso o formulario tem 55 linhas...
			Cabec(Titulo,Cabec1,Cabec2,NomeProg,Tamanho,nTipo)
			nLin := 9
		Endif

		@nlin,00 psay S01->D3_LOCAL
		@nlin,8 psay S01->D3_COD
		@nlin,27 psay substr(S01->B1_DESC,1,25)
		@nlin,56 psay S01->D3_CF
		@nlin,63 psay S01->D3_QUANT    picture "@E 999,999.99"
		@nlin,81 psay S01->D3_UM
		@nlin,85 psay S01->D3_QTSEGUM  picture "@E 999,999.99"
		@nlin,110 psay S01->D3_SEGUM
		if !empty(D3_ZZOP)
			@nlin,122 psay S01->D3_ZZOP
		else
			@nlin,122 psay S01->D3_OP
		endif
		@nlin,145 psay S01->D3_ZZPALET
		@nlin,160 psay dtoc(stod(S01->D3_EMISSAO))
		@nlin,175 psay S01->D3_USUARIO

		nlin+=1

		S01->(dbSkip())

	EndDo

	if select("S01") > 0
		S01->(dbclosearea())
	endif

	//??????????????????????????????????????????????????????????????????????
	//? Finaliza a execucao do relatorio...                                 ?
	//???????????????????????????????????????????????????????????????????????

	SET DEVICE TO SCREEN

	//??????????????????????????????????????????????????????????????????????
	//? Se impressao em disco, chama o gerenciador de impressao...          ?
	//???????????????????????????????????????????????????????????????????????

	If aReturn[5]==1
		dbCommitAll()
		SET PRINTER TO
		OurSpool(wnrel)
	Endif

	MS_FLUSH()

Return


