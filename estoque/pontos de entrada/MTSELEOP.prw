****************************************************************************
User Function MTSELEOP
****************************************************************************
local lRet := .T.
IF ALLTRIM(UPPER(FUNNAME())) == "MATA410" .OR. ALLTRIM(UPPER(FUNNAME())) == "MATA415" 
	lRet := .F.	
ENDIF
Return lRet
