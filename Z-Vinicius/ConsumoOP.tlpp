#include "protheus.ch"
#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
    
namespace custom.consumoop
 
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGEST", tables="SD3", name="Consumo OP", country="ALL", initialRelease="12.1.2210")
//-------------------------------------------------------------------
/*{Protheus.doc} consumoopTReportsBusinessObject
Classe para criação do Objeto de Negócio de Prod  x Forn para o TReports
 
@author Vanessa Ruama
@since 02/03/2023
@version 1.0
*/
//-------------------------------------------------------------------  
class consumoopTReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider
    public method new() as object
    public method getData() as object
    public method getSchema() as object
 
    protected data aFields as array
    protected data aStruct as array
 
endclass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Vanessa Ruama
@since 02/03/2023
@version 1.0
*/
//-------------------------------------------------------------------   
method new() class consumoopTReportsBusinessObject
_Super:new()
self:appendArea("TESTE")
self:setDisplayName("Consumo OP X Empenho")
self:setDescription("Análise entre o Consumo da OP e o Empenho da Estrututa")
 
self:aFields := {"FILIAL", "OP", "PRODUTO_PAI", "QUANTIDADE_OP", "QUANT_OP1", "COMPONENTE","QUANT_EMPENHO","QUANT_CONSUMIDA","TM","MES", "CUSTO","EMPENHO_RECALC","DIF_CONSUMIDA"}
self:aStruct := getStruct(self:aFields)
 
return self
 
//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Vanessa Ruama
@since 02/03/2023
@version 1.0
*/
//-------------------------------------------------------------------   
method getData(nPage as numeric, oFilter as object) as object class consumoopTReportsBusinessObject
local cQuery as character
local cAlias as character
local nSkip as numeric
local nCount as numeric
local nX as numeric
local jItems as json
local aPDFields as array
local lUseParams as logical
  
nCount := 0
cQuery := "WITH CONSUMO (FILIAL, OP, PRODUTO_PAI, QUANTIDADE_OP, QUANT_OP1, COMPONENTE, QUANT_CONSUMIDA, TM, CUSTO, MES) as( "
cQuery += "Select D3_FILIAL, D3_OP, C2_PRODUTO, C2_QUANT, round(C2_QUJE,2), D3_COD, round(SUM(D3_QUANT),2) as QUANT_COMSUNIDA, "
cQuery += "Case When D3_TM in ('912','999','901') Then 'CONSUMO' Else 'ERROR' End as TM, round(SUM(D3_CUSTO1),2) as CUSTO, substring(D3_EMISSAO,1,6)as MES "
cQuery += "From SD3010 (NOLOCK) Inner Join "
cQuery += "     SC2010 (NOLOCK) ON D3_FILIAL = C2_FILIAL and D3_OP = C2_NUM+C2_ITEM+C2_SEQUEN and SC2010.D_E_L_E_T_='' and SD3010.D_E_L_E_T_ ='' and D3_TM in ('912','999','901')  and C2_PRODUTO <>'MANUTENCAO' and C2_QUJE >'0' "
cQuery += "Where (D3_EMISSAO >= CONVERT(date, GETDATE() - 5, 112)) "
cQuery += "Group BY  D3_FILIAL, D3_OP, C2_PRODUTO, C2_QUANT, C2_QUJE, D3_COD, Case When D3_TM in ('912','999','901') Then 'CONSUMO' Else 'ERROR' End, substring(D3_EMISSAO,1,6)) "
cQuery += "Select FILIAL, OP, PRODUTO_PAI, QUANTIDADE_OP, QUANT_OP1, COMPONENTE, round(D4_QTDEORI,2) as QUANT_EMPENHO, QUANT_CONSUMIDA, TM, CUSTO, MES, "
cQuery += "round(sum((D4_QTDEORI/QUANTIDADE_OP)*QUANT_OP1),2) EMPENHO_RECALC, Round(SUM(QUANT_CONSUMIDA-((D4_QTDEORI/QUANTIDADE_OP)*(QUANT_OP1))),2) as DIF_CONSUMIDA "
cQuery += "From CONSUMO Left Outer Join "
cQuery += "     SD4010 (NOLOCK) ON  Filial = D4_FILIAL and OP = D4_OP and COMPONENTE = D4_COD and SD4010.D_E_L_E_T_='' "
cQuery += "Group By FILIAL, OP, PRODUTO_PAI, QUANTIDADE_OP, QUANT_OP1, COMPONENTE, QUANT_CONSUMIDA, TM, round(D4_QTDEORI,2), CUSTO, MES "
cQuery += "Order By OP "
lUseParams := .T.

//Os filtros serão setados na interface do novo TReports
if oFilter:hasFilter()
    cQuery += " AND " + oFilter:getSQLExpression()
endif

jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

if ValType(jParams["01"]) <> "A"
    lUseParams := .F.
endif

if lUseParams .and. !empty(jParams["01"][1])
    cQuery += " AND OP = " + jParams['01'][1]
endif
  
cAlias := MPSysOpenQuery(cQuery)
  
if nPage == 1
    (cAlias)->(dbGoTop())
else
    //Encontra a quantidade de itens que irá pular de acordo com a página atual
    nSkip := ((nPage - 1) * self:getPageSize())     
  
    (cAlias)->(dbSkip(nSkip))
endif  
  
//Verifica se precisa fazer o tratamento para LGPD
  aPDFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:aFields)
  lObfuscated := len( aPDFields ) != Len(self:aFields)

while !(cAlias)->(Eof())
    jItems := JsonObject():new()
 
    for nX := 1 To Len(self:aStruct)
        if lObfuscated .and. aScan(aPDFields, self:aStruct[nX][13]) == 0
            jItems[self:aStruct[nX][1]] := FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->&(self:aStruct[nX][5]))
        else
            jItems[self:aStruct[nX][1]] := (cAlias)->&(self:aStruct[nX][5])
        endif
    next nX
 
    self:oData:appendData(jItems)
 
    (cAlias)->(DBSkip())
    nCount++
  
    //Sai do loop quando chegar no tamanho de itens da página
    if nCount == self:getPageSize()
      exit
    endif
enddo 
  
//Se não for o último registro indica que terá próxima página
self:setHasNext(!(cAlias)->(Eof())) 
  
(cAlias)->(DBCloseArea())
    
return self:oData
 
//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Vanessa Ruama
@since 02/03/2023
@version 1.0
*/
//-------------------------------------------------------------------   
//V method getSchema() as object class consumoopTReportsBusinessObject
//V Local nX as numeric
 
