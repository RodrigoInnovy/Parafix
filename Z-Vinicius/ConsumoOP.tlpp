//V return self:oSchema
 
method getSchema() as object class consumoopTReportsBusinessObject

//"QUANT_EMPENHO","QUANT_CONSUMIDA","TM","MES", "CUSTO","EMPENHO_RECALC","DIF_CONSUMIDA"}

self:addProperty("FILIAL", "FILIAL", "string", "FILIAL", "FILIAL")
self:addProperty("OP", "OP", "string", "OP", "OP")
self:addProperty("PRODUTO_PAI", "PRODUTO_PAI", "string", "PRODUTO_PAI","PRODUTO_PAI")
self:addProperty("QUANTIDADE_OP", "QUANTIDADE_OP", "string", "QUANTIDADE_OP","QUANTIDADE_OP")
self:addProperty("QUANT_OP1", "QUANT_OP1", "string", "QUANT_OP1","QUANT_OP1")
self:addProperty("COMPONENTE", "COMPONENTE", "string", "COMPONENTE","COMPONENTE")

return self:oSchema





//-------------------------------------------------------------------
/*{Protheus.doc} getStruct
Prepara a estrutura dos campos
 
@param aFlds array: Array com os campos do relatório
 
@return array: Array com a estrutura dos campos
 
@author Vanessa Ruama
@since 02/03/2023
@version 1.0
*/
//------------------------------------------------------------------- 
static function getStruct(aFlds)
Local aConvFld as array
Local aFldTmp    as array
Local cCampo     as character
Local cFldQry    as character
Local cTipR      as character
Local nPos       as numeric
Local nC         as numeric
 
aConvFld := {{"C", "string"}, {"D", "date"}, {"N", "number"}, {"L", "boolean"}, {"M", "memo"}}
aFldTmp    := {}
 
for nC := 1 to Len(aFlds)
    cFldQry := aFlds[nC]
    nPos    := AT(".", aFlds[nC]) + 1
     
    if nPos > 0
        cCampo := Substr(cFldQry, nPos)
    else
        cCampo := cFldQry
    endif
     
    cTipo := GetSx3Cache(cCampo, "X3_TIPO")
     
    if (nPos := aScan(aConvFld, {|c| c[01] = cTipo})) > 0
        cTipR := aConvFld[nPos, 02]
    else
        cTipR := "string"
    endif
 
    AAdd(aFldTmp, {cCampo, FWSX3Util():GetDescription(cCampo), cTipR, FwX3Titulo(Upper(cCampo)), cCampo})
next nC
 
return (aFldTmp)
