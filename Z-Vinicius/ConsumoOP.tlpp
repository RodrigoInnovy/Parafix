    //V self:addProperty(self:aStruct[nX][1], self:aStruct[nX][2], self:aStruct[nX][3], self:aStruct[nX][4], self:aStruct[nX][5])
//V Next nX

//V self:addParameter("01"  , "Codigo OP ", "string", .F.)


//Consulta dos parâmetros
